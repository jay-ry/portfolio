# Environment variable template.
# Copy to `.env` (used by docker compose) or `.env.local` (used by `next dev`),
# then fill in GROQ_API_KEY. Both filenames are gitignored.
#
# Every value below is the built-in default, so the file is safe to copy as-is —
# only GROQ_API_KEY and TRUSTED_PROXY_HOPS normally need your attention.

# Required for the AI chat. No default.
# Without it the site still builds and boots normally; the chat reports itself
# offline and the other six sections are unaffected.
# Get a key at https://console.groq.com
GROQ_API_KEY=

# Primary model used by the chat.
CHAT_MODEL=openai/gpt-oss-120b

# Fallback model, tried once when the primary returns a 5xx or the network fails.
CHAT_MODEL_FALLBACK=openai/gpt-oss-20b

# Timeout for a single chat request, in milliseconds.
CHAT_REQUEST_TIMEOUT_MS=20000

# Length of the rate-limit window, in milliseconds.
CHAT_RATE_LIMIT_WINDOW_MS=60000

# Max chat requests allowed per client per rate-limit window.
# Sized against real provider capacity: Groq's free tier allows 8000 tokens/min
# per model and one grounded request costs ~2200 (the whole portfolio knowledge
# block is sent every time) — roughly 3/min per model, ~7 across the primary and
# its fallback. Staying under that means a fast-typing visitor gets a friendly
# "wait a moment" rather than an opaque provider error. Raise it if you upgrade
# your Groq tier.
CHAT_RATE_LIMIT_MAX=6

# How many reverse proxies sit between the public internet and this app.
# This decides whether X-Forwarded-For / X-Real-IP are believed at all, so the
# rate limiter keys on the real client rather than on a header anyone can type.
#
#   0 — nothing in front of the app, or you are not sure. Forwarding headers are
#       ignored entirely and all callers share one bucket. Safe but coarse.
#   1 — exactly one reverse proxy. This is the deployed setup: the container
#       publishes no ports and is reached by domain routing.
#   2 — a CDN (Cloudflare etc.) in front of that proxy.
#
# Never set this higher than the real number of proxies. The value means "how
# many entries at the END of X-Forwarded-For were written by machines we control",
# so an inflated count steps past them into the part of the list the CALLER
# supplied — handing an attacker control of the rate-limit key again, which is
# exactly the bypass this setting exists to close. Too low only costs precision.
TRUSTED_PROXY_HOPS=1
